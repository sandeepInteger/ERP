dist/
build/
.turbo/
*.tsbuildinfo
.vite/
.eslintcache
.cache/

# Android app (apps/mobile). android/.gitignore covers the generated project too; these stay here in case it
# is ever regenerated with `cap add android`.
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/release/
apps/mobile/android/app/src/main/assets/public/
