# Render demo only: the SPA plus /api forwarded to the API's own Render URL, so the browser
# sees one origin (refresh cookie works as behind the real load balancer).
# The nginx image fills ${API_HOST} from the environment at start (e.g. erp-api-abcd.onrender.com).
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 30m;

    location /api/ {
        proxy_pass https://${API_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # A sleeping free API takes up to a minute to wake.
        proxy_connect_timeout 120s;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    add_header X-Frame-Options "DENY";
    add_header X-Content-Type-Options "nosniff";
}
