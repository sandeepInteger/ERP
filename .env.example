# Copy to apps/api/.env for local development.

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/integer_erp

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173

# Local development only: shows "Developer sign-in" on the login page so seeded
# users can sign in without Microsoft. Ignored unless NODE_ENV=development.
DEV_LOGIN=true

# ─── Microsoft sign-in (Azure Entra ID) ───────────────────────────────────────
# App registration → Authentication → Web redirect URI must equal AZURE_REDIRECT_URI.
# Locally the web dev server proxies /api, so the callback goes through port 5173.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:5173/api/auth/sso/azure/callback

# ─── Email notifications (optional) ───────────────────────────────────────────
# Leave SMTP_HOST empty to keep notifications in the app only (the bell).
# Microsoft 365: smtp.office365.com, port 587, a mailbox allowed to send (SMTP AUTH on).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Base URL used for links in emails.
APP_URL=http://localhost:5173

# ─── Field crew email-code sign-in ────────────────────────────────────────────
# Code requests allowed per IP per 15 minutes (verify allows twice this). Default 10,
# or 200 when DEV_LOGIN is on. Each person is also limited to 5 codes an hour.
# OTP_IP_LIMIT=10

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# Escalations, the morning stand-up digest and the bimonthly report reminder run every
# 15 minutes. Set false on any extra API instance so only one runs them.
JOBS_ENABLED=true
# Local hour from which the stand-up digest and report reminder go out.
DIGEST_HOUR=8

# ─── Document storage ─────────────────────────────────────────────────────────
# Local folder for uploaded site documents (SOV, BOM, RFDS, AE202, photos).
UPLOAD_DIR=./uploads
